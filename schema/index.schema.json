{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shinp-dev/chanriva-content/main/schema/index.schema.json",
  "title": "Chanriva content index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "url", "sizeBytes", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "version": {"type": "integer", "minimum": 1},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
