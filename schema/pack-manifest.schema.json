{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shinp-dev/chanriva-content/main/schema/pack-manifest.schema.json",
  "title": "Chanriva content pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "version": {"type": "integer", "minimum": 1}
  }
}
